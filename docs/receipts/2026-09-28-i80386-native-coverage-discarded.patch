@@ -201,0 +202,46 @@ uint32_t block_spike_run(uint32_t start, uint32_t end, uint32_t event_budget) {
+    if (ins.op == OP_MOVSB) {
+      // Destination: base/disp/lo/hi. Source: dst/src/index/scale.
+      // Validate both RAM pages before touching either one.
+      const uint32_t source_offset = state.regs[6];
+      const uint32_t destination_offset = state.regs[7];
+      const uint32_t source_address = source_offset + ins.src;
+      const uint32_t destination_address = destination_offset + ins.disp;
+      if (ins.length != 1 || ins.width != 8 ||
+          ins.index >= ins.scale || ins.scale > ram_capacity ||
+          (source_offset & ~4095u) != ins.dst ||
+          source_address < ins.index || source_address >= ins.scale ||
+          ins.lo >= ins.hi || ins.hi > ram_capacity ||
+          (destination_offset & ~4095u) != ins.base ||
+          destination_address < ins.lo || destination_address >= ins.hi)
+        return (EXIT_FAULT_BOUNDARY << 24) | completed;
+      ((uint8_t *)(uintptr_t)(ram_ptr + destination_address))[0] =
+        ((uint8_t *)(uintptr_t)(ram_ptr + source_address))[0];
+      const uint32_t delta = (state.eflags & 0x400u) ? -1u : 1u;
+      state.regs[6] += delta;
+      state.regs[7] += delta;
+      state.eip++;
+      state.cycles++;
+      completed++;
+      pc++;
+      continue;
+    }
+    if (ins.op == OP_STORE_WINDOW) {
+      const uint32_t base = ins.base < 8 ? state.regs[ins.base] : 0;
+      const uint32_t index = ins.index < 8 ? state.regs[ins.index] : 0;
+      const uint32_t offset = base + (index << ins.scale) + ins.disp;
+      const uint32_t address = offset + ins.hi;
+      // dst is the proved linear page; hi carries the physical delta.
+      if (ins.length < 2 || ins.length > 7 || ins.width != 32 ||
+          ins.src >= 8 || ins.base > 8 || ins.index > 8 || ins.scale > 3 ||
+          (offset & ~4095u) != ins.dst || (offset & 4095u) > 4092u ||
+          ins.lo > ram_capacity - 4096u ||
+          address < ins.lo || address >= ins.lo + 4096u ||
+          4u > ins.lo + 4096u - address)
+        return (EXIT_FAULT_BOUNDARY << 24) | completed;
+      write_ram32(address, state.regs[ins.src]);
+      state.eip += ins.length;
+      state.cycles++;
+      completed++;
+      pc++;
+      continue;
+    }
