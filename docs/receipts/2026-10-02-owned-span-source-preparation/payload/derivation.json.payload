  "edits": [
    {
      "old": "from './reset-witness.mjs'",
      "next": "from '../bochs-cpu3-native-owned-in8/reset-witness.mjs'",
      "label": "relocate reset witness import"
    },
    {
      "old": "const apply=Reflect.apply;",
      "next": "import {ExperimentalI80386ATMachine} from '../../src/experimental/i80386-at-machine.js';\nimport {DirectBoardFacade} from '../bochs-cpu3-native-direct-board/board.mjs';\nimport {NativeCombinedPagingRamHost} from '../bochs-cpu3-native-combined-paging-ram/host.mjs';\nconst decode386=ExperimentalI80386ATMachine.prototype._decode386,gate386=ExperimentalI80386ATMachine.prototype._gate386;\nconst facadeClass=DirectBoardFacade.prototype._class,hostClass=NativeCombinedPagingRamHost.prototype._class;\nconst apply=Reflect.apply;",
      "label": "capture pinned affine decoder and uniform classifier"
    },
    {
      "old": "export function createOwnedIn8Provider(",
      "next": "export function createOwnedSpanProvider(",
      "label": "separate private factory"
    },
    {
      "old": " class In8Board extends HotDirectBoardFacade {\n",
      "next": " class In8Board extends HotDirectBoardFacade {\n  // Private, source-pinned page proof. Generic span and every board effect remain original.\n  span(raw,width,{execute=false}={}){\n   // Invalid arguments take the original validator, in its original error order.\n   if(!Number.isSafeInteger(raw)||raw<0||raw>0xffffffff||\n      !Number.isSafeInteger(width)||width<0||width>(execute?4096:16)||\n      width===0||raw>0xffffffff-(width-1)||(raw&4095)+width>4096)\n    return super.span(raw,width,{execute});\n   const m=this.machine;\n   // A different decoder/classifier is outside this proof, even if its endpoints agree.\n   if(m._decode386!==decode386||m._gate386!==gate386||this._class!==facadeClass||\n      NativeCombinedPagingRamHost.prototype._class!==hostClass||\n      !Number.isSafeInteger(m._resetRomAliasBase)||m._resetRomAliasBase<0||\n      m._resetRomAliasBase>0xffff0000||(m._resetRomAliasBase&4095)!==0||\n      m._xv6Mp||m.vgaMemory)\n    return super.span(raw,width,{execute});\n   // Effective A20 gating precedes reset-alias decode; classification excludes video first.\n   const decoded=m._decode386(raw),kind=this._class(decoded),last=decoded+width-1;\n   if((kind!==1&&kind!==2)||!Number.isSafeInteger(decoded)||decoded<0||\n      decoded>0xffffffff-(width-1)||(decoded&4095)+width>4096||last>=m.memoryBytes||\n      m._page[decoded>>>12]!==kind||\n      m._mmio.some(w=>last>=w.start&&decoded<=w.end))\n    return super.span(raw,width,{execute});\n   // Within one raw page the pinned bit-20 gate and aligned reset alias are affine.\n   // _page 1/2 proves the entire decoded page is one RAM/ROM region, without MMIO.\n   if(execute&&!(width===4096&&(raw&4095)===0&&(decoded&4095)===0&&\n      (kind===2||(kind===1&&[0x7000,0x107000].includes(decoded)&&[0x7000,0x107000].includes(raw)))))\n    return super.span(raw,width,{execute});\n   return {decoded,kind};\n  }\n",
      "label": "private span proof only"
    }
  ],
  "inverseSha256": "fc2dda9353edd0f28d7bac26bb5336ee2f946a63b405be33d7ba14099ac8c1c0"
}
