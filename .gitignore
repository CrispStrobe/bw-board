node_modules/
# ...and node_modules as a SYMLINK, which `node_modules/` does not match: a
# trailing slash means "directory only". That is how a self-referential
# node_modules symlink came to be COMMITTED here — tracked under an ignore
# rule that could not see it — dead-ending module resolution in any fresh
# clone until it was untracked.
node_modules
.claude/

# Agent working notes: local context, not documentation.
CLAUDE.md
.resync-tx.bin
scripts/tms9918/vdppeer
emu8051-stc/

# labwired-wasm build output: 21 MB of artifact per run. The build script
# defaults here (scripts/build-labwired-wasm.mjs --out), and the artifact is
# published as a release asset, never committed.
build/

# Built by scripts/build-bios.mjs. A generated image should never be
# committed: it would be reviewed as source and diffed as noise, and the
# next `git add -A` in a shared tree would sweep it in -- which has already
# happened once here with someone else's in-flight work.
rom/*.bin

# Generated census snapshots. `npm run census:json` writes here, but the
# snapshot's HOME IS brickwright-lite, which commits it as
# docs/generated/oracle-census.json and derives its language-device matrix
# from it. bw-board owns the GENERATOR; lite owns the artefact.
#
# Committing it here too would create a second copy that drifts the moment
# either repo moves, and the whole arrangement exists to avoid a second set of
# semantics. Left untracked-and-unignored it is worse still: a generated file
# nobody declared, which is the shape that lets an untracked artefact make a
# check pass.
docs/generated/
